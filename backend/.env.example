# Backend runtime
HOST=0.0.0.0
PORT=8000

# Recommended for cloud runtimes like Render (no GPU)
SKIP_LOCAL_MODEL=true

# Free-tier Render default (ephemeral storage)
CORTEX_DATA_DIR=/tmp/cortex
# If using a persistent disk later, switch to: /var/data/cortex

# Gemini API key used by LLM and voice paths
GOOGLE_API_KEY=your_google_api_key_here

# Optional managed database URL (Render Postgres).
# Note: current metadata storage remains DuckDB/FAISS in CORTEX_DATA_DIR.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: secure API access (if set, clients must send Authorization: Bearer <key>)
# CORTEX_API_KEY=change_this_to_a_strong_secret

# Optional CORS overrides (comma-separated origins and regex)
# CORS_ALLOW_ORIGINS=https://your-frontend.onrender.com,https://your-custom-domain.com
# CORS_ALLOW_ORIGIN_REGEX=^https://.*\.onrender\.com$|^https://your-custom-domain\.com$
