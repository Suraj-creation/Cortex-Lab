# Backend runtime
HOST=0.0.0.0
PORT=8000

# Recommended for Railway (no GPU)
SKIP_LOCAL_MODEL=true

# Gemini API key used by LLM and voice paths
GOOGLE_API_KEY=your_google_api_key_here

# Optional: secure API access (if set, clients must send Authorization: Bearer <key>)
# CORTEX_API_KEY=change_this_to_a_strong_secret

# Optional CORS overrides (comma-separated origins and regex)
# CORS_ALLOW_ORIGINS=https://your-frontend-domain.up.railway.app,https://your-custom-domain.com
# CORS_ALLOW_ORIGIN_REGEX=^https://.*\.up\.railway\.app$|^https://your-custom-domain\.com$
