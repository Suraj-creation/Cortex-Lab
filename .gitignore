# .gitignore

# Dependencies
node_modules/
venv/
__pycache__/
*.pyc
.pyo

# Next.js
.next/
out/

# Model files (large binaries - not tracked)
# Use /models/ (root-anchored) so backend/src/models/ source code is NOT ignored
/models/
/cache/
checkpoints/
output/

# Fine-tuned model outputs (large binaries)
fine_tuned/
fine_tuned_gemma4/
training_data/gemma4/raw/
training_data/gemma4/*.jsonl

# Training logs
*.log
nohup.out

# Environment
.env
.env.local
.env.production

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# RAG data
backend/data/
/data/
*.duckdb
*.duckdb.wal
*.npy

# Build artifacts
tsconfig.tsbuildinfo
.eslintrc.json

# Agent Skills (installed per-user via npx skills add)
.agents/
.claude/skills/
.cursor/skills/
.github/skills/
.copilot/
.windsurf/skills/
.gemini/skills/
.venv/
