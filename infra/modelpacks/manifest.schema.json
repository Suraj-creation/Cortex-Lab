{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cortex Modelpack Manifest",
  "type": "object",
  "required": ["schema_version", "generated_at", "packs", "signature_required"],
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "signature_required": { "type": "boolean" },
    "source": { "type": "string" },
    "docs_url": { "type": "string" },
    "channels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "packs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "display_name", "version", "files"],
        "properties": {
          "id": { "type": "string" },
          "display_name": { "type": "string" },
          "version": { "type": "string" },
          "target": { "type": "string" },
          "family": { "type": "string" },
          "quantization": { "type": "string" },
          "summary": { "type": "string" },
          "availability": {
            "type": "string",
            "enum": ["available", "coming_soon"]
          },
          "download_url": { "type": "string" },
          "cta_label": { "type": "string" },
          "docs_url": { "type": "string" },
          "requires": {
            "type": "array",
            "items": { "type": "string" }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "size_bytes", "sha256"],
              "properties": {
                "path": { "type": "string" },
                "size_bytes": { "type": "integer", "minimum": 0 },
                "sha256": { "type": "string", "minLength": 64, "maxLength": 64 }
              }
            }
          }
        }
      }
    }
  }
}
